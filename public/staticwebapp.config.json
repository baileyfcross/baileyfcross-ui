    },
    {
      "route": "/about/index.html",
      "redirect": "/about/",
      "statusCode": 301
    },
    {
      "route": "/teaching/index.html",
      "redirect": "/teaching/",
      "statusCode": 301
    },
    {
      "route": "/projects/index.html",
      "redirect": "/projects/",
      "statusCode": 301
    },
    {
      "route": "/hobbies/index.html",
      "redirect": "/hobbies/",
      "statusCode": 301
    },
    {
      "route": "/courses/index.html",
      "redirect": "/courses/",
      "statusCode": 301
    },
    {
      "route": "/404.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "route": "/404/",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "route": "/_not-found/",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    }
